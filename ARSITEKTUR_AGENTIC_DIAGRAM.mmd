%% ================================================================
%% AGENTIC MARKET DESK — peta arsitektur (versi rinci / poster)
%% Prinsip: semua angka lahir di lapisan deterministik; LLM hanya menilai.
%% Render: mmdc -i ARSITEKTUR_AGENTIC_DIAGRAM.mmd -o ARSITEKTUR_AGENTIC_DIAGRAM.svg -b white
%% Urutan agen mengikuti services/analysisService.ts (OFFICE_ROSTER).
%% ================================================================
%%{init: {"flowchart": {"wrappingWidth": 330, "curve": "basis"}, "fontSize": 15}}%%
flowchart TD

    subgraph DATA["Sumber data"]
        direction LR
        YF["Yahoo Finance<br/>quote · OHLCV 3 tahun · fundamental<br/>profil · 7 seri makro"]
        GN["Google News RSS Indonesia<br/>≤12 artikel dalam 45 hari"]
        IDX["Universe IDX<br/>957 emiten · sektor IDX-IC"]
    end

    CACHE["Cache in-memory ber-TTL<br/>quote 30 dtk · histori 5 mnt · berita 5 mnt<br/>makro 10 mnt · fundamental 6 jam"]

    ING["① Data Ingestion<br/>tarik paralel, validasi kelengkapan<br/>→ ok / degraded / failed"]

    DET["Lapisan deterministik — tanpa LLM<br/>indikator: SMA · RSI · MACD · ATR · OBV<br/>rasio: PER · PBV · ROE · DER · growth<br/>rezim: VIX · kurva 10Y-3M · DXY · IHSG<br/>risiko: ¼ Kelly · SL 2×ATR · TP 2R<br/>alokasi: 6 kendala eksposur"]

    T["② Technical<br/>S_tech ∈ [-1,+1]<br/>C_tech, label tren"]
    F["③ Fundamental<br/>S_fund ∈ [-1,+1]<br/>Murah / Wajar / Mahal"]
    M["④ Macro<br/>risk_on / neutral<br/>/ risk_off"]
    N["⑤ News &amp; Sentiment<br/>S_sent ∈ [-1,+1]<br/>event material"]

    SYN["⑥ Synthesizer<br/>bobot horizon × rezim + confidence<br/>skor konsensus, agreement, P_up"]

    CRT["⑦ Critic<br/>13 aturan + red-team LLM<br/>pass / caution / reject"]

    RSK["⑧ Risk Manager<br/>6 kendala → lot, alokasi Rupiah<br/>kill switch drawdown"]

    subgraph OUT["Keluaran"]
        direction LR
        DEC["Keputusan per emiten<br/>strong_buy … sell<br/>entry · SL · TP · lot · Rp"]
        PICK["Top Picks<br/>3 trading + 2 investasi<br/>957 → shortlist 10+10"]
        DB["Jejak audit<br/>SQLite app.db<br/>+ cache JSON"]
        UI["React UI + Kantor 3D<br/>skor agen, objections"]
    end

    YF --> CACHE
    GN --> CACHE
    IDX --> CACHE
    CACHE --> ING
    ING --> DET

    DET -.-> T
    DET -.-> F
    DET -.-> M
    DET -.-> N

    T --> SYN
    F --> SYN
    M --> SYN
    N --> SYN

    SYN --> CRT
    CRT -->|"pass / caution"| RSK
    CRT -.->|"reject: veto beli"| DEC

    RSK --> DEC
    RSK --> PICK
    DEC --> DB
    PICK --> DB
    DEC --> UI
    PICK --> UI

    classDef src fill:#E8F0FE,stroke:#1A73E8,color:#0B2545
    classDef det fill:#EEF1F6,stroke:#5F6B7A,color:#1B2430
    classDef llm fill:#F3EAFB,stroke:#7B3FA0,color:#2A0B3D
    classDef out fill:#E9F7EC,stroke:#2E7D32,color:#0F2A12
    class YF,GN,IDX src
    class CACHE,ING,DET,RSK det
    class T,F,M,N,SYN,CRT llm
    class DEC,PICK,DB,UI out