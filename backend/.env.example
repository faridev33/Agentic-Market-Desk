# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATA_DIR=./data
# Folder hasil build frontend, relatif terhadap folder backend.
# Jika berisi index.html, server ikut melayaninya.
WEB_DIR=../frontend/dist
# Daftar origin dipisah koma, atau * untuk mengizinkan semua
CORS_ORIGIN=*

# Kredensial LLM (opsional). Tanpa ini, agen sentimen & critic memakai
# analisis leksikon/heuristik deterministik.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Daftar model untuk fallback otomatis (dipisah koma). Urutan = prioritas.
# Dipakai panel "5 Emiten Rekomendasi Beli" agar agen tetap jalan saat satu model down.
LLM_MODELS=
LLM_TIMEOUT_MS=20000

# Benchmark & makro
BENCHMARK_SYMBOL=^GSPC

# Batas risiko default
MAX_RISK_PER_TRADE_PCT=1
TARGET_VOLATILITY_PCT=15
MAX_POSITION_PCT=20
MAX_DRAWDOWN_PCT=15
MAX_SECTOR_EXPOSURE_PCT=35
